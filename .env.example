# ---------------------------------------------------------------------------
# Azure DevOps Support & Incident AI Assistant - environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Modes -----------------------------------------------------------------
# DEMO_MODE=false -> uses ADO_* credentials (normal operation).
# NOTE: no bundled demo data ships with the repo; DEMO_MODE=true will fail.
DEMO_MODE=false

# --- Azure DevOps ----------------------------------------------------------
# PAT needs: Work Items (Read)
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=Your Support Project
ADO_PAT=
ADO_API_VERSION=7.1-preview

# --- Reports -----------------------------------------------------------------
# Client-facing project name used in report titles (defaults to ADO_PROJECT).
REPORT_PROJECT_NAME=Xanadu Digital Ecosystem (XDE)

# --- AI model (any OpenAI-compatible endpoint) -----------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Audit log (local dev only; off by default, not required in prod) ------
AUDIT_LOG_ENABLED=false
AUDIT_LOG=backend/logs/audit.jsonl
